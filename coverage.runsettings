<?xml version="1.0" encoding="utf-8"?>
<!-- Cobertura do coverlet, usada pelo dotnet test do CI com o coletor "XPlat Code Coverage".
     Conta só o projeto da API e deixa fora as migrations, que são código gerado. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[FamilyVaultApi]*</Include>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
