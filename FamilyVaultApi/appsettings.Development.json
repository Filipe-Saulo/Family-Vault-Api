{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "JwtSettings": {
    "Issuer": "FamilyVaultApi",
    "Audience": "FamilyVaultApiClient",
    "DurationInMinutes": 10
  },
  "Gmail": {
    "RedirectUri": "https://localhost:7072/api/gmail/callback",
    "AllowedReturnUrls": [ "familyvault://gmail", "http://localhost:5173/gmail" ]
  },
  "AdminSeed": {
    "Email": "",
    "Password": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning" }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
