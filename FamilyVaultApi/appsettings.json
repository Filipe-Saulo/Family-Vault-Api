{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=FamilyVault;User=root; password=; Persist Security Info=False;"
  },
  "JwtSettings": {
    "Issuer": "FamilyVaultApi",
    "Audience": "FamilyVaultApiClient",
    "DurationInMinutes": 10
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1m", "Limit": 100 },
      { "Endpoint": "post:/api/web/login", "Period": "1m", "Limit": 5 },
      { "Endpoint": "post:/api/app/login", "Period": "1m", "Limit": 5 },
      { "Endpoint": "post:/api/register", "Period": "1m", "Limit": 5 },
      { "Endpoint": "post:/api/register/code", "Period": "1m", "Limit": 3 },
      { "Endpoint": "post:/api/password/forgot", "Period": "1m", "Limit": 3 },
      { "Endpoint": "post:/api/password/reset", "Period": "1m", "Limit": 5 },
      { "Endpoint": "post:/api/password/change", "Period": "1m", "Limit": 5 },
      { "Endpoint": "post:/api/web/refreshtoken", "Period": "1m", "Limit": 10 },
      { "Endpoint": "post:/api/app/refreshtoken", "Period": "1m", "Limit": 10 }
    ]
  },
  "VerificationCode": {
    "SendLimit": { "MinIntervalSeconds": 60, "PerDay": 1, "GlobalSmsPerDay": 5 }
  },
  "Charges": {
    "MaxUploadBytes": 10485760,
    "DailyLimits": { "PerUser": 20, "Total": 100 },
    "Worker": { "Enabled": true, "PollIntervalMilliseconds": 10000, "BatchSize": 5, "MaxAttempts": 3, "StuckAfterMinutes": 10, "RetryDelaySeconds": 60 }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "System.Net.Http.HttpClient": "Warning" }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
