# Variáveis de ambiente da API fora de Development (Container App). Só os nomes: os valores reais ficam nos secrets do
# Container Apps (ou no Key Vault), nunca neste repositório. Vazio = obrigatório; com valor = sugestão.

ASPNETCORE_ENVIRONMENT=Production

# Banco (Azure SQL). O mesmo valor vai para o Container Apps Job das migrations (/app/efbundle).
ConnectionStrings__DefaultConnection=

# JWT: 32+ bytes
JwtSettings__Key=

# Administrador criado na subida, se ainda não existir
AdminSeed__Email=
AdminSeed__Password=

# Conta demo pública (só leitura, dados fictícios refeitos uma vez por dia na subida). Desligada sem Enabled=true.
# A senha é a publicada no README e na tela de login; nunca a de uma conta real.
# DemoSeed__Enabled=true
# DemoSeed__Email=
# DemoSeed__Password=

# Envio real dos códigos: sem estes a API não sobe fora de Development
Sms__Twilio__AccountSid=
Sms__Twilio__AuthToken=
Sms__Twilio__From=
Email__Resend__ApiKey=
Email__Resend__From=

# Proxy: a imagem já liga o ForwardedHeaders. 1 = só o ingress do Container Apps; 2 = ingress + nginx do painel
ForwardedHeaders__ForwardLimit=1

# CORS: vazio quando o painel chama pela mesma origem (nginx). Uma origem por índice.
# Cors__AllowedOrigins__0=

# Opcionais: sem eles a parte correspondente fica desligada
# Ai__ApiKey=
# Gmail__ClientId=
# Gmail__ClientSecret=
# Gmail__TokenEncryptionKey=
# Gmail__RedirectUri=https://familyvault.filipesaulo.com.br/api/gmail/callback
# Gmail__AllowedReturnUrls__0=familyvault://gmail
# Gmail__AllowedReturnUrls__1=https://familyvault.filipesaulo.com.br/gmail
# GoogleSignIn__ClientIds__0=
# GoogleSignIn__ClientIds__1=
